{
  "version": "1.0",
  "sections": [
    {
      "id": "test_visual_effects",
      "name": "🎨 Visual Effects Test",
      "description": "Fields with immediate visible changes",
      "icon": "palette",
      "order": 1,
      "settings": [
        {
          "id": "text_color",
          "label":  "️ 1️⃣ 32 Text Color",
          "type": "color",
          "default": "rgb(17, 24, 39)",
          "description": "Main text color across the site",
          "css_var": "--base-color",
          "palette": "default"
        },
        {
          "id":  "primary_button_color",
          "label": " 2️⃣  Primary Button Color",
          "type": "color",
          "default": "#1979c3",
          "description": "Changes all primary buttons (Add to Cart, etc.)",
          "css_var": "--button-primary-bg",
          "help_text": "Try #e63946 (red) or #06ffa5 (green)",
          "palette": "default"
        },
        {
          "id": "link_color",
          "label":  "3️⃣ Link Color",
          "type": "color",
          "default": "rgb(29, 78, 216)",
          "description": "All clickable links",
          "css_var": "--link-color",
          "palette": "default"
        },
        {
          "id": "text_opacity",
          "label": "4️⃣ Text Opacity",
          "type": "range",
          "default": "1",
          "min": "0.3",
          "max": "1",
          "step": "0.05",
          "description": "Make text more/less transparent",
          "css_var":  "--base-alpha"
        },
        {
          "id":  "animation_speed",
          "label": "5️⃣ Animation Speed",
          "type": "range",
          "default": "200",
          "min": "0",
          "max": "1000",
          "step": "50",
          "unit": "ms",
          "description": "Hover effects speed (try 1000ms for slow-mo)",
          "css_var":  "--transition-duration"
        }
      ]
    },
    {
      "id": "test_layout",
      "name": "📐 Layout Test",
      "description": "Fields that change page structure",
      "icon": "view_column",
      "order": 2,
      "settings": [
        {
          "id": "container_width",
          "label":  "6️⃣ Container Max Width",
          "type": "select",
          "default": "1280px",
          "options":  [
            {"value": "800px", "label": "Narrow (800px)"},
            {"value": "1024px", "label": "Medium (1024px)"},
            {"value": "1280px", "label": "Wide (1280px)"},
            {"value": "1536px", "label": "Extra Wide (1536px)"},
            {"value": "100%", "label": "Full Width"}
          ],
          "description":  "Page content max width",
          "css_var": "--container-max-width"
        },
        {
          "id": "grid_columns",
          "label":  "7️⃣ Product Grid Columns",
          "type": "number",
          "default": "3",
          "min": "2",
          "max": "6",
          "step": "1",
          "description": "Products per row (go to catalog page to see)",
          "css_var":  "--listing-grid-columns",
          "help_text": "Navigate to a category page to see this effect"
        },
        {
          "id": "grid_gap",
          "label": "8️⃣ Product Grid Gap",
          "type":  "select",
          "default":  "1rem",
          "options": [
            {"value": "0.25rem", "label": "Extra Tight (4px)"},
            {"value":  "0.5rem", "label": "Tight (8px)"},
            {"value": "1rem", "label": "Normal (16px)"},
            {"value": "1.5rem", "label": "Relaxed (24px)"},
            {"value": "2rem", "label": "Loose (32px)"}
          ],
          "description": "Space between products",
          "css_var": "--listing-grid-gap"
        },
        {
          "id":  "sidebar_width",
          "label":  "9️⃣ Sidebar Width",
          "type":  "text",
          "default": "220px",
          "description": "Left sidebar width (on pages with sidebar)",
          "css_var": "--sidebar-width",
          "placeholder": "220px"
        }
      ]
    },
    {
      "id": "test_all_types",
      "name": "🧪 All Field Types",
      "description": "One of each field type",
      "icon":  "settings",
      "order": 3,
      "settings": [
        {
          "id": "test_toggle",
          "label": "🔟 Sticky Header",
          "type": "toggle",
          "default": true,
          "description": "Enable/disable sticky header on scroll",
          "css_var": "--header-sticky"
        },
        {
          "id": "test_textarea",
          "label": "1️⃣1️⃣ Custom CSS",
          "type": "textarea",
          "default": "/* Add your custom styles here */",
          "description":  "Inject custom CSS (advanced)",
          "rows": 10,
          "help_text": "Example: body { font-size: 18px; }"
        },
        {
          "id": "test_font",
          "label": "1️⃣2️⃣ Body Font",
          "type": "font_picker",
          "default": "Open Sans",
          "description": "Main text font family",
          "css_var": "--font-family-base",
          "options": [
            {"value": "Open Sans", "label": "Open Sans"},
            {"value": "Roboto", "label": "Roboto"},
            {"value": "Lato", "label": "Lato"},
            {"value": "Montserrat", "label": "Montserrat"},
            {"value": "Georgia", "label": "Georgia"},
            {"value": "serif", "label": "Serif"}
          ]
        }
      ]
    }
  ],
  "palettes": {
    "default": {
      "id": "default",
      "label": "Default Color Palette",
      "description": "Professional color system for theme customization",
      "groups": {
        "brand": {
          "id": "brand",
          "label": "Brand Colors",
          "description": "Primary brand identity colors",
          "colors": [
            {
              "id": "primary",
              "label": "Primary",
              "description": "Main brand color for buttons and key elements",
              "css_var": "--color-brand-primary",
              "default": "#1979c3"
            },
            {
              "id": "secondary",
              "label": "Secondary",
              "description": "Supporting brand color for headers and emphasis",
              "css_var": "--color-brand-secondary",
              "default": "#111827"
            },
            {
              "id": "accent",
              "label": "Accent",
              "description": "Highlight color for links and interactive elements",
              "css_var": "--color-brand-accent",
              "default": "#1d4ed8"
            },
            {
              "id": "amber-primary",
              "label": "Amber Primary",
              "description": "Warm alternative primary color",
              "css_var": "--color-brand-amber-primary",
              "default": "#eab308"
            },
            {
              "id": "amber-dark",
              "label": "Amber Dark",
              "description": "Deep warm color for text and emphasis",
              "css_var": "--color-brand-amber-dark",
              "default": "#a16207"
            }
          ]
        },
        "neutral": {
          "id": "neutral",
          "label": "Neutral Colors",
          "description": "Grayscale palette for backgrounds, borders, and text",
          "colors": [
            {
              "id": "0",
              "label": "White",
              "description": "Pure white",
              "css_var": "--color-neutral-0",
              "default": "#ffffff"
            },
            {
              "id": "50",
              "label": "Gray 50",
              "description": "Lightest gray",
              "css_var": "--color-neutral-50",
              "default": "#f9fafb"
            },
            {
              "id": "100",
              "label": "Gray 100",
              "description": "Very light gray",
              "css_var": "--color-neutral-100",
              "default": "#f3f4f6"
            },
            {
              "id": "200",
              "label": "Gray 200",
              "description": "Light gray",
              "css_var": "--color-neutral-200",
              "default": "#e5e7eb"
            },
            {
              "id": "300",
              "label": "Gray 300",
              "description": "Medium-light gray",
              "css_var": "--color-neutral-300",
              "default": "#d1d5db"
            },
            {
              "id": "400",
              "label": "Gray 400",
              "description": "Medium gray",
              "css_var": "--color-neutral-400",
              "default": "#9ca3af"
            },
            {
              "id": "500",
              "label": "Gray 500",
              "description": "Base gray",
              "css_var": "--color-neutral-500",
              "default": "#6b7280"
            },
            {
              "id": "600",
              "label": "Gray 600",
              "description": "Medium-dark gray",
              "css_var": "--color-neutral-600",
              "default": "#4b5563"
            },
            {
              "id": "700",
              "label": "Gray 700",
              "description": "Dark gray - ideal for body text",
              "css_var": "--color-neutral-700",
              "default": "#374151"
            },
            {
              "id": "800",
              "label": "Gray 800",
              "description": "Very dark gray",
              "css_var": "--color-neutral-800",
              "default": "#1f2937"
            },
            {
              "id": "900",
              "label": "Gray 900",
              "description": "Darkest gray - almost black",
              "css_var": "--color-neutral-900",
              "default": "#111827"
            }
          ]
        },
        "state": {
          "id": "state",
          "label": "State Colors",
          "description": "Semantic colors for UI feedback",
          "colors": [
            {
              "id": "success",
              "label": "Success",
              "description": "Positive actions and confirmations",
              "css_var": "--color-state-success",
              "default": "#10b981"
            },
            {
              "id": "warning",
              "label": "Warning",
              "description": "Caution and important notices",
              "css_var": "--color-state-warning",
              "default": "#f59e0b"
            },
            {
              "id": "error",
              "label": "Error",
              "description": "Errors and destructive actions",
              "css_var": "--color-state-error",
              "default": "#ef4444"
            },
            {
              "id": "info",
              "label": "Info",
              "description": "Informational messages",
              "css_var": "--color-state-info",
              "default": "#3b82f6"
            }
          ]
        }
      }
    }
  },
  "presets": [
    {
      "id": "dark-mode",
      "name": "🌙 Dark Mode",
      "description": "Complete dark color scheme with high contrast for better readability in low-light conditions. Perfect for night browsing.",
      "settings": {
        "test_visual_effects.primary_button_color": "#3b82f6",
        "test_visual_effects.text_color": "rgb(243, 244, 246)",
        "test_visual_effects.link_color": "rgb(96, 165, 250)",
        "test_visual_effects.animation_speed": "300"
      }
    },
    {
      "id": "high-contrast",
      "name": "♿ High Contrast",
      "description": "Maximum contrast accessibility theme with bold colors and clear distinction between elements. Designed for users with visual impairments.",
      "settings": {
        "test_visual_effects.primary_button_color": "#dc2626",
        "test_visual_effects.text_color": "rgb(0, 0, 0)",
        "test_visual_effects.link_color": "rgb(0, 0, 255)",
        "test_visual_effects.text_opacity": "1"
      }
    },
    {
      "id": "minimal-clean",
      "name": "✨ Minimal Clean",
      "description": "Clean and minimal light theme with generous spacing and soft colors. Focus on content with distraction-free design.",
      "settings": {
        "test_visual_effects.primary_button_color": "#ffffff",
        "test_visual_effects.text_color": "rgb(31, 41, 55)",
        "test_visual_effects.link_color": "rgb(75, 85, 99)",
        "test_layout.container_width": "1024px",
        "test_layout.grid_gap": "1.5rem"
      }
    }
  ]
}
